#!/bin/sh
# commit-msg hook: enforces Conventional Commits
# https://www.conventionalcommits.org

msg_file="$1"

header=$(tr -d '\r' < "$msg_file" | grep -v '^#' | sed '/^[[:space:]]*$/d' | head -n 1)

if printf '%s' "$header" | grep -qE '^(Merge|Revert|fixup!|squash!|amend!) '; then
    exit 0
fi

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"
max_length=72

if ! printf '%s' "$header" | grep -qE "$pattern"; then
    echo ""
    echo "ERROR: Commit message does not follow Conventional Commits."
    echo ""
    echo "  Got:      $header"
    echo ""
    echo "  Expected: <type>(<optional scope>)!: <description>"
    echo "  Types:    $(echo "$types" | sed 's/|/, /g')"
    echo ""
    echo "  Examples: feat(renderer): add Vulkan swapchain recreation"
    echo "            fix: prevent crash on empty asset path"
    echo "            refactor(core)!: rename Engine::Init to Engine::Startup"
    echo ""
    exit 1
fi

if [ "${#header}" -gt "$max_length" ]; then
    echo ""
    echo "ERROR: Commit header is ${#header} characters (max $max_length)."
    echo "  $header"
    echo ""
    exit 1
fi

exit 0